@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 35
hide empty members

package "Application Python" <<app>> {
  node "scheduler_5min(callback) -> None\nuses lib: time" as f_sched
  node "main_loop(tick_seconds:int) -> None" as f_main

  node "read_dry_state(gpio_pin:int) -> bool\nuses lib: RPi.GPIO\nuses hw: GPIO" as f_dry
  node "scan_active_channels(enabled:list[int]) -> int\nnotes: retourne canal 1..4" as f_scan

  node "select_rref(channel:int) -> None\nuses lib: RPi.GPIO\nuses hw: TMUX1204" as f_rref

  node "adc_configure_and_read(channel:int, inpmux:int, gain:int, osr:int, ref_sel:int, idac_uA:int, timeout_ms:int) -> int\nuses lib: spidev, RPi.GPIO\nuses hw: ADS124S08 SPI1" as f_adc
  node "compute_Tmes(adc_code:int, rref_index:int) -> float\nnotes: conversion code→Tmes" as f_tmes

  node "fetch_api_params(url:str, token:str) -> tuple[int,float,float]\nuses lib: requests, json\nnotes: N, kM, Tprevu" as f_api
  node "compute_regulation(Tmes:float, N:int, kM:float, Tprevu:float) -> tuple[int,int,float]\nnotes: slot, step, Tsim" as f_ctrl
  node "program_mux(slot:int, step:int) -> None\nuses lib: spidev\nuses hw: ADG731 SPI0" as f_mux

  node "log_event(tag:str, fields:dict) -> None\nuses lib: logging" as f_log
  node "led_activity(pattern:str) -> None\nuses lib: RPi.GPIO\nuses hw: GPIO" as f_led
  node "set_relay_bypass(state:bool) -> None\nuses lib: RPi.GPIO\nuses hw: GPIO" as f_relay
}

' Graphe d'appels propre
f_sched --> f_main

' Séquence périodique côté application
f_main --> f_dry
f_main --> f_scan
f_scan --> f_rref
f_scan --> f_adc
f_adc  --> f_tmes

f_main --> f_api
f_main --> f_ctrl
f_ctrl --> f_mux

' Effets de bord génériques
f_main --> f_log
f_main --> f_led
f_main --> f_relay

' Petites annotations I/O
note right of f_dry
in gpio_pin
out bool contact
end note

note right of f_adc
in canal + cfg adc
out code 24 bits
end note

note right of f_ctrl
in Tmes N kM Tprevu
out slot step Tsim
end note

legend right
Lib stdlib: time, logging, json
Lib tierces: requests, spidev, RPi.GPIO
Périphériques: ADS124S08 SPI1, ADG731 SPI0, TMUX1204, GPIO
endlegend
@enduml