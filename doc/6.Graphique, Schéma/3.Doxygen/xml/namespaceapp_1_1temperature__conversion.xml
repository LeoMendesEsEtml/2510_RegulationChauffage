<parametername>table</parametername>
</parameternamelist>
<parameterdescription>
<para>Liste de tuples (résistance, température) pour interpolation.</para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>Température interpolée [°C], ou valeurs limites si hors plage. </para>
</simplesect>
</para>
        </detaileddescription>
