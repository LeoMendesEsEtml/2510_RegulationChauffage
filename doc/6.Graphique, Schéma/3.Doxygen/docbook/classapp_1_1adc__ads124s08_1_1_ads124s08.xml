                            <row>
<entry>channel_index</entry><entry>
<para>Index du canal physique (1-4). </para>
</entry>
                            </row>
                            <row>
<entry>pga_gain</entry><entry>
<para>Gain de l&apos;amplificateur programmable (1-128). </para>
</entry>
                            </row>
                            <row>
<entry>idac_uA</entry><entry>
<para>Courant IDAC en microampères (10-2000).</para>
</entry>
                            </row>
                        </tbody>
                        </tgroup>
                    </table>
                    </para>
                </formalpara>
                <formalpara><title>Renvoie</title>

<para>Rien.</para>
</formalpara>

