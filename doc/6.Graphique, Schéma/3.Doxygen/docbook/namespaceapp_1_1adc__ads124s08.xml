        <mediaobject>
            <imageobject>
                <imagedata width="50%" align="center" valign="middle" scalefit="0" fileref="namespaceapp_1_1adc__ads124s08_a8f9279b8505f8d634ed73c51dcab29c9_icgraph.svg"></imagedata>
