32 {\cf22              d\'E9lais entre mesures et configuration des canaux de capteurs.}\par
33 {\cf22 }\par
34 {\cf22     @param   path Chemin vers le fichier de configuration JSON.}\par
35 {\cf22 }\par
36 {\cf22     @return  Dictionnaire Python contenant les donn\'E9es de configuration.}\par
37 {\cf22 }\par
38 {\cf22     @exception FileNotFoundError Si le fichier n'existe pas.}\par
39 {\cf22     @exception json.JSONDecodeError Si le fichier n'est pas un JSON valide.}\par
40 {\cf22 }\par
41 {\cf22     @example}\par
42 {\cf22       Format JSON attendu:}\par
43 {\cf22       \{}\par
44 {\cf22         "timeout_s": 180,}\par
45 {\cf22         "inter_measure_sleep_s": 0.1,}\par
46 {\cf22         "loop_sleep_s": 1.0,}\par
47 {\cf22         "channels": [}\par
48 {\cf22           \{ "channel": 1, "sensor": "Ni1000 TK5000" \}}\par
49 {\cf22         ]}\par
50 {\cf22       \}}\par
51 {\cf22     """}\par
52     {\cf20 # V\'E9rification de l'existence du fichier}\par
53     {\cf19 if} os.path.exists(path) {\cf19 is} {\cf17 False}:\par
54         {\cf20 # Lever une exception si le fichier n'existe pas}\par
55         {\cf19 raise} FileNotFoundError({\cf22 "Config introuvable: "} + str(path))\par
56     {\cf20 # Ouverture et lecture du fichier JSON}\par
57     {\cf17 with} open(path, {\cf22 "r"}, encoding={\cf22 "utf-8"}) {\cf17 as} f:\par
58         {\cf20 # Parsing du contenu JSON}\par
59         data = json.load(f)\par
60     {\cf20 # Retour des donn\'E9es pars\'E9es}\par
61     {\cf19 return} data\par
\par}
 \par
}
