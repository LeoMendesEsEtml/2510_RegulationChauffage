@startuml EventFlow

' Acteurs et composants logiques
actor "Opérateur" as user
participant "Système Central" as main
participant "Gestionnaire Config" as config
participant "Sélecteur Canaux" as selector
participant "Capteur Acquisition" as sensor
participant "Tables Conversion" as tables
participant "Moteur Calcul" as calculator
participant "Algorithme Régulation" as regulation
participant "Interface Réseau" as network
participant "Contrôleur E/S" as io
participant "Superviseur Erreurs" as monitor
participant "Ordonnanceur" as scheduler

' Séquence d'initialisation
== Phase d'Initialisation ==
user -> main : Lancement du système
main -> config : Chargement paramètres
config --> main : Paramètres système
main -> io : Initialisation matériel
main -> selector : Configuration multiplexage
main -> sensor : Préparation acquisition

' Séquence de cycle principal
== Cycle Opérationnel ==
main -> scheduler : Activation planification
scheduler -> scheduler : Exécution cycles automatiques

' Séquence de mesure
== Phase d'Acquisition ==
group Collecte des Données
    main -> io : Lecture états binaires
    io --> main : États système
    
    loop Pour Chaque Point de Mesure
        main -> selector : Sélection canal physique
        main -> sensor : Configuration paramètres acquisition
        main -> sensor : Réglage amplification
        main -> sensor : Configuration référence
        main -> sensor : Démarrage mesure
        main -> sensor : Attente fin conversion
        sensor --> main : Valeur brute
        main -> calculator : Conversion en grandeur physique
        calculator --> main : Valeur résistance
        main -> tables : Recherche correspondance
        tables --> main : Valeur température
    end
end

' Séquence de régulation
== Phase de Régulation ==
group Cycle de Contrôle
    main -> network : Récupération paramètres distants
    network --> main : Coefficients de régulation
    main -> regulation : Application algorithme prédictif
    regulation --> main : Consignes de commande
    main -> calculator : Calcul simulation température
    calculator --> main : Valeur température simulée
    main -> tables : Conversion en grandeur électrique
    tables --> main : Valeur résistance simulée
    main -> io : Application simulation physique
    main -> network : Transmission données système
end

' Séquence de traitement d'erreur
== Gestion des Anomalies ==
group Traitement des Erreurs
    main -> monitor : Détection problème
    monitor -> io : Activation mode sécurisé
    monitor -> io : Signalisation état
    monitor -> main : Notification erreur
    main -> network : Remontée information problème
end

' Séquence d'arrêt
== Phase d'Arrêt ==
user -> main : Demande arrêt système
main -> sensor : Arrêt acquisitions
main -> sensor : Mise en veille composants
main -> io : Libération ressources matérielles

@enduml
