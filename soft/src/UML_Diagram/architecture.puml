@startuml Architecture_Reelle

' ===================== PACKAGE APP (MODULE PRINCIPAL) =====================
package "app" {
  class "main.py" as Main {
    -sequencer_running: bool
    -stop_event: threading.Event
    -force_sequence: threading.Event
    -led_indicator: LedErrorIndicator
    +main()
    +run_measurement_sequence()
    +save_last_state()
    +signal_handler()
    +input_monitor()
    +show_error_and_continue()
    +start_webui_server()
    +reload_timing_config()
  }

  class "adc_ads124s08.py::Ads124s08" as ADC {
    -spi: spidev.SpiDev
    -gpio_drdy: GPIO
    -gpio_reset: GPIO
    +__init__()
    +read_id()
    +configure_channel()
    +measure_resistance()
    +measure_temperature()
    +start()
    +stop()
    +wait_drdy_falling_edge()
    +read_code24()
    +close()
  }

  class "hw_tmux1204.py::Tmux1204" as TMUX {
    -gpio_a1: GPIO
    -gpio_a0: GPIO
    +__init__()
    +select_rref_ohm()
    +set_bits()
    +close()
  }

  class "hw_mux_adg731.py::Adg731MuxSpi" as MUX_ADG731 {
    -spi: spidev.SpiDev
    -cs_pins: list
    +__init__()
    +select_card()
    +set_channel()
    +power_up()
    +power_down()
    +close()
  }

  class "api_client.py::ApiClient" as APIClient {
    -mac_address: str
    -base_url: str
    +__init__(mac_address)
    +get_parameters()
    +get_forecast()
    +send_temperature_data()
  }

  class "resistance_simulation.py::ResistanceSimulator" as ResistSim {
    +apply_resistance_simulation()
    +_calculate_mux_commands()
    +_validate_resistance()
  }

  class "temperature_simulation.py" as TempSim {
    +run_temperature_simulation()
    +calculate_simulated_temperature()
    +validate_simulation_parameters()
  }

  class "temperature_conversion.py" as TempConv {
    +resistance_to_temperature()
    +resistance_to_temperature_dynamic()
    +convert_temperature_to_resistance()
  }

  class "sensor_profiles.py" as SensorProfiles {
    +SENSOR_TABLES: dict
    +get_profile()
    +validate_sensor_name()
  }

  class "front_led_management.py::LedErrorIndicator" as LEDManager {
    -led_gpio: GPIO
    -patterns: dict
    +__init__()
    +show_pattern()
    +stop()
    +_blink_thread()
  }

  class "config_loader.py" as ConfigLoader {
    +load_config()
    +validate_config()
    +get_default_config()
  }

  class "mesure_24v_dry_contact.py" as DryContacts {
    +test_24v_dry_contact()
    +get_dry_contact_status()
    +read_gpio_state()
  }

  class "resistance_mapping.py" as ResistMapping {
    +get_channel_mux_map()
    +find_closest_channel()
    +validate_resistance_range()
  }

  class "pins_cm5.py" as PinsCM5 {
    +GPIO_CHIP_PATH: str
    +SPI1_BUS: int
    +SPI1_DEV0: int
    +ADC_DRDY: int
    +ADC_RESET: int
    +FRONT_LED: int
    +CMD_RELAY: int
  }
}

' ===================== PACKAGE CONFIG_MODULE =====================
package "config_module" {
  class "cm5_config.py" as CM5Config {
    +ADC_CHANNELS: list
    +build_hw()
  }

  class "sensors.json" as SensorsConfig {
    <<fichier>>
    +channels: list
    +global_settings: dict
  }
}

' ===================== PACKAGE WEBUI =====================
package "webui" {
  class "webui_server.py" as WebUIServer {
    +app: Flask
    +serve_index()
    +get_config()
    +put_config()
    +get_state()
  }

  class "index.html" as WebInterface {
    <<fichier>>
    +Interface de configuration
    +Affichage temps réel
  }
}

' ===================== PACKAGE STATE =====================
package "state" {
  class "last_state.json" as StateFile {
    <<fichier>>
    +channels: dict
    +last_timestamp: str
    +last_channel: int
    +error_log: list
  }
}

' ===================== BIBLIOTHÈQUES SYSTÈME =====================
package "Bibliothèques Système" {
  class "periphery::GPIO" as GPIO {
    +__init__(chip, line, direction)
    +read()
    +write()
    +close()
  }

  class "spidev::SpiDev" as SPI {
    +open(bus, device)
    +xfer2(data)
    +close()
  }

  class "requests" as HTTP {
    +get()
    +post()
    +timeout()
  }

  class "threading" as Threading {
    +Thread()
    +Event()
    +Lock()
  }

  class "flask::Flask" as Flask {
    +route()
    +run()
    +jsonify()
  }
}

' ===================== SERVICES EXTERNES =====================
package "Services Externes" {
  class "API oblosolutions.ch" as ExternalAPI {
    +/td25_param
    +/td25_forecast
    +/td25_data
  }
}

' ===================== RELATIONS PRINCIPALES =====================

' Relations du module principal
Main --> ADC : "utilise"
Main --> TMUX : "utilise"
Main --> APIClient : "utilise"
Main --> TempSim : "utilise"
Main --> ResistSim : "utilise"
Main --> TempConv : "utilise"
Main --> SensorProfiles : "utilise"
Main --> LEDManager : "utilise"
Main --> ConfigLoader : "utilise"
Main --> DryContacts : "utilise"
Main --> StateFile : "écrit/lit"

' Relations des drivers matériels
ADC --> SPI : "communication"
ADC --> GPIO : "signaux DRDY/RESET"
TMUX --> GPIO : "signaux A0/A1"
MUX_ADG731 --> SPI : "communication"
LEDManager --> GPIO : "contrôle LED"
DryContacts --> GPIO : "lecture contacts"

' Relations de configuration
ConfigLoader --> SensorsConfig : "lit"
CM5Config --> PinsCM5 : "utilise"
Main --> CM5Config : "initialisation HW"

' Relations simulation et mapping
ResistSim --> MUX_ADG731 : "commande"
ResistSim --> ResistMapping : "calcul canaux"
TempConv --> SensorProfiles : "tables conversion"

' Relations API et réseau
APIClient --> HTTP : "requêtes"
APIClient --> ExternalAPI : "communication"

' Relations interface web
WebUIServer --> Flask : "serveur"
WebUIServer --> SensorsConfig : "lit/écrit"
WebUIServer --> StateFile : "lit"
WebUIServer --> WebInterface : "sert"

' Relations threading
Main --> Threading : "séquenceur, webui, clavier"

' ===================== NOTES SUR L'ARCHITECTURE =====================
note right of Main
  **Module Principal**
  - Séquenceur automatique
  - Gestion signaux système
  - Coordination tous modules
  - Sauvegarde état
end note

note right of ADC
  **Driver ADC ADS124S08**
  - Communication SPI
  - Mesure résistance/température
  - Configuration gain/référence
  - Gestion DRDY
end note

note right of APIClient
  **Client API REST**
  - Paramètres simulation
  - Prévisions météo
  - Envoi données mesures
  - Retry automatique
end note

note right of WebUIServer
  **Interface Web**
  - Configuration capteurs
  - Monitoring temps réel
  - API REST JSON
  - Thread séparé
end note

@enduml
