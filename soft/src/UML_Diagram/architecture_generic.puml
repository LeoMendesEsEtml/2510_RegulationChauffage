@startuml ArchitectureGeneric
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam defaultTextAlignment center
skinparam padding 20
skinparam componentPadding 16
skinparam packagePadding 16

' Définition des couleurs par couche
!define APP_COLOR E3F2FD
!define SERVICES_COLOR FFECB3  
!define BUSINESS_COLOR E8F5E9
!define HAL_COLOR F3E5F5
!define DRIVERS_COLOR FAFAFA
!define HARDWARE_COLOR CFD8DC

' === COUCHE APPLICATION ===
package "Application Layer" as app_layer #APP_COLOR {
  component "Main Controller" as main_ctrl
  component "System Manager" as sys_mgr
  component "Configuration Manager" as config_mgr
}

' === COUCHE SERVICES ===
package "Service Layer" as service_layer #SERVICES_COLOR {
  component "API Gateway" as api_gw
  component "Task Scheduler" as scheduler
  component "Data Logger" as logger
  component "Fault Manager" as fault_mgr
  component "Persistence Service" as persistence
}

' === COUCHE METIER ===
package "Business Logic Layer" as business_layer #BUSINESS_COLOR {
  component "Regulation Engine" as regulation
  component "Temperature Controller" as temp_ctrl
  component "Sensor Manager" as sensor_mgr
  component "Profile Manager" as profile_mgr
  component "Simulation Engine" as simulation
}

' === COUCHE ABSTRACTION MATERIELLE ===
package "Hardware Abstraction Layer" as hal_layer #HAL_COLOR {
  component "Temperature Interface" as temp_if
  component "Digital I/O Interface" as dio_if
  component "Communication Interface" as comm_if
  component "Timer Interface" as timer_if
}

' === COUCHE PILOTES ===
package "Driver Layer" as driver_layer #DRIVERS_COLOR {
  component "SPI Driver" as spi_drv
  component "GPIO Driver" as gpio_drv
  component "ADC Driver" as adc_drv
  component "MUX Driver" as mux_drv
  component "Timer Driver" as timer_drv
}

' === COUCHE MATERIELLE ===
package "Hardware Layer" as hw_layer #HARDWARE_COLOR {
  component "Microcontroller" as mcu
  component "Temperature Sensors" as temp_sensors
  component "Dry Contacts" as dry_contacts
  component "Communication Bus" as comm_bus
}

' === RELATIONS VERTICALES (Architecture en couches) ===
' Application -> Services
main_ctrl -down-> api_gw
main_ctrl -down-> scheduler
sys_mgr -down-> fault_mgr
config_mgr -down-> persistence

' Services -> Business Logic
api_gw -down-> regulation
scheduler -down-> temp_ctrl
logger -down-> sensor_mgr
fault_mgr -down-> profile_mgr

' Business Logic -> HAL
regulation -down-> temp_if
temp_ctrl -down-> dio_if
sensor_mgr -down-> comm_if
simulation -down-> timer_if

' HAL -> Drivers
temp_if -down-> adc_drv
dio_if -down-> gpio_drv
comm_if -down-> spi_drv
timer_if -down-> timer_drv

' Drivers -> Hardware
spi_drv -down-> comm_bus
gpio_drv -down-> dry_contacts
adc_drv -down-> temp_sensors
mux_drv -down-> mcu
timer_drv -down-> mcu

' === RELATIONS HORIZONTALES (Collaboration) ===
' Au niveau Application
main_ctrl <-right-> sys_mgr
sys_mgr <-right-> config_mgr

' Au niveau Services
scheduler <-right-> logger
fault_mgr <-right-> persistence

' Au niveau Business Logic
regulation <-right-> temp_ctrl
sensor_mgr <-right-> profile_mgr
temp_ctrl <-right-> simulation

' Au niveau Drivers
spi_drv <-right-> mux_drv
gpio_drv <-right-> adc_drv

note top of app_layer : **Couche Application**\nGestion globale du système\nConfiguration et supervision
note top of service_layer : **Couche Services**\nServices transversaux\nScheduling, logging, persistance
note top of business_layer : **Couche Métier**\nLogique de régulation\nGestion des capteurs et profils
note top of hal_layer : **Couche d'Abstraction**\nInterfaces génériques\nIndépendantes du matériel
note top of driver_layer : **Couche Pilotes**\nPilotes spécifiques\nAccès direct au matériel
note bottom of hw_layer : **Couche Matérielle**\nComposants physiques\nCapteurs, actionneurs, MCU

@enduml
